{
  "name": "ocpool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src/app src/components src/lib scripts tests playwright.config.ts",
    "test:content": "node scripts/pool-site-contract.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "analyze": "node scripts/analyze-bundle.mjs",
    "test:unit": "vitest run tests/unit",
    "test:unit:watch": "vitest tests/unit",
    "test:integration": "cross-env RUN_DB_TESTS=1 vitest run tests/integration",
    "test:e2e:foundation": "cross-env FOUNDATION_E2E=1 playwright test tests/foundation-health.spec.ts",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "node scripts/require-env.mjs DATABASE_URL && prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:up": "docker compose up -d postgres mailpit",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs --follow postgres mailpit",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "motion": "^13.1.1",
    "next": "^15.5.24",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "^15.5.24",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.24",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "sharp": "0.35.4"
  }
}
