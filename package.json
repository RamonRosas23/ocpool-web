{
  "name": "ocpool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run typecheck && npm run test:unit && npm run test:integration && npm run test:content && npm run build && npm run test:e2e && npm run test:e2e:foundation",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/app src/components src/lib scripts tests playwright.config.ts",
    "test:content": "node scripts/pool-site-contract.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "analyze": "node scripts/analyze-bundle.mjs",
    "test:unit": "vitest run tests/unit",
    "test:unit:watch": "vitest tests/unit",
    "test:integration": "cross-env RUN_DB_TESTS=1 vitest run tests/integration --maxWorkers=1",
    "test:e2e:foundation": "cross-env FOUNDATION_E2E=1 playwright test tests/foundation-health.spec.ts",
    "test:e2e:auth": "cross-env AUTH_E2E=1 APP_URL=http://127.0.0.1:3100 playwright test tests/auth.spec.ts",
    "validate:production": "cross-env NODE_ENV=production tsx scripts/validate-production-env.ts",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "node scripts/require-env.mjs DATABASE_URL && prisma migrate deploy",
    "db:seed": "prisma db seed",
    "worker:notifications:once": "tsx scripts/notifications-worker-once.ts",
    "worker:notifications": "tsx scripts/notifications-worker.ts",
    "db:up": "docker compose up -d postgres mailpit minio",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs --follow postgres mailpit minio",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@node-rs/argon2": "^2.2.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "motion": "^13.1.1",
    "next": "^15.5.24",
    "nodemailer": "^10.0.1",
    "otpauth": "^9.5.2",
    "pdf-lib": "1.17.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "^15.5.24",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^7.0.12",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.24",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@humanfs/node": "0.16.8",
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.3",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "sharp": "0.35.4"
  }
}
