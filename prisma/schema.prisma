generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum NotificationChannel {
  EMAIL
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum UserType {
  CUSTOMER
  EMPLOYEE
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum ClientStatus {
  ACTIVE
  ARCHIVED
}

enum ContactStatus {
  ACTIVE
  ARCHIVED
}

enum QuoteRequestOrigin {
  PUBLIC_FORM
  STAFF_CREATED
}

enum QuoteRequestStatus {
  RECIBIDA
  EN_REVISION
  INFORMACION_REQUERIDA
  EN_ELABORACION
  COTIZACION_DISPONIBLE
  EN_NEGOCIACION
  PENDIENTE_DE_APROBACION
  ACEPTADA
  RECHAZADA
  VENCIDA
  CONVERTIDA_EN_PROYECTO
}

enum QuoteRequestProjectStage {
  IDEA
  SITE_READY
  UNDER_CONSTRUCTION
  REMODEL
  EQUIPMENT_ONLY
  UNSURE
}

enum QuoteRequestTimeline {
  ASAP
  ONE_TO_THREE_MONTHS
  THREE_TO_SIX_MONTHS
  SIX_PLUS_MONTHS
  UNSURE
}

enum QuoteRequestBudgetRange {
  UNDER_250K
  FROM_250K_TO_500K
  FROM_500K_TO_1M
  OVER_1M
  UNSURE
}

enum CatalogStatus {
  ACTIVE
  ARCHIVED
}

enum PriceListStatus {
  ACTIVE
  ARCHIVED
}

enum ConversationStatus {
  OPEN
  CLOSED
}

enum MessageVisibility {
  CUSTOMER
  INTERNAL
}

enum StorageProvider {
  MINIO
}

enum FileScanStatus {
  PENDING
  PASSED
  REJECTED
}

enum FileAttachmentStatus {
  PENDING_SCAN
  AVAILABLE
  REJECTED
  DELETED
}

enum FileCategory {
  REFERENCE_IMAGE
  TECHNICAL_DOCUMENT
  CLIENT_DOCUMENT
  INTERNAL_DOCUMENT
}

enum FileVisibility {
  CUSTOMER
  INTERNAL
}

enum GeneratedDocumentType {
  QUOTE_PDF
}

enum GeneratedDocumentStatus {
  PENDING
  READY
  FAILED
  DELETED
}

enum QuoteVersionStatus {
  BORRADOR
  EN_REVISION
  ENVIADA
  EN_NEGOCIACION
  ACEPTADA
  RECHAZADA
  VENCIDA
}

enum QuoteApprovalType {
  DISCOUNT
  PRICE_OVERRIDE
  SPECIAL_CONCEPT
}

enum QuoteApprovalStatus {
  REQUESTED
  APPROVED
  REJECTED
  CANCELLED
  SUPERSEDED
}

/// D1-03: only rounding rule in use today (half-up per line, then sum).
/// A future rule is a new enum value, never a change of meaning of this one.
enum TaxRoundingRule {
  HALF_UP
}

enum QuotePublicationStatus {
  PUBLISHED
  SUPERSEDED
}

/// J1-01: deliberately a two-state flag, not a construction-project state machine -- see the doc
/// comment on `Project` itself.
enum ProjectHandoffStatus {
  EN_TRANSICION
  COMPLETADO
}

enum AuthTokenType {
  MAGIC_LINK
  PASSWORD_RESET
  MFA_RECOVERY
}

enum AuthEventType {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  MAGIC_LINK_REQUEST
  MAGIC_LINK_CONSUMED
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET_CONSUMED
  MFA_ENROLLED
  MFA_CHALLENGE
  MFA_FAILURE
  SESSION_CREATED
  SESSION_REVOKED
}

enum AuthEventOutcome {
  SUCCESS
  DENIED
  FAILURE
}

model SystemSetting {
  key       String   @id @db.VarChar(120)
  value     Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("system_settings")
}

model AuditLog {
  id          String       @id @default(uuid()) @db.Uuid
  actorUserId String?      @db.Uuid
  action      String       @db.VarChar(120)
  entityType  String       @db.VarChar(120)
  entityId    String?      @db.Uuid
  outcome     AuditOutcome
  metadata    Json?
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

model OutboxEvent {
  id                     String                 @id @default(uuid()) @db.Uuid
  eventType              String                 @db.VarChar(160)
  aggregateType          String                 @db.VarChar(120)
  aggregateId            String?                @db.Uuid
  payload                Json
  status                 OutboxStatus           @default(PENDING)
  attempts               Int                    @default(0)
  availableAt            DateTime               @default(now()) @db.Timestamptz(3)
  processedAt            DateTime?              @db.Timestamptz(3)
  lastError              String?                @db.VarChar(1000)
  createdAt              DateTime               @default(now()) @db.Timestamptz(3)
  notificationDeliveries NotificationDelivery[]

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

model NotificationDelivery {
  id                         String                     @id @default(uuid()) @db.Uuid
  outboxEventId              String                     @db.Uuid
  channel                    NotificationChannel        @default(EMAIL)
  recipientUserId            String?                    @db.Uuid
  recipientAddressCiphertext String?                    @db.VarChar(600)
  recipientAddressHash       String?                    @db.Char(64)
  templateKey                String                     @db.VarChar(120)
  templateVersion            String                     @db.VarChar(64)
  subjectSnapshot            String?                    @db.VarChar(240)
  payload                    Json?
  status                     NotificationDeliveryStatus @default(PENDING)
  attempts                   Int                        @default(0)
  availableAt                DateTime                   @default(now()) @db.Timestamptz(3)
  processingStartedAt        DateTime?                  @db.Timestamptz(3)
  processedAt                DateTime?                  @db.Timestamptz(3)
  lastErrorCode              String?                    @db.VarChar(80)
  providerMessageId          String?                    @db.VarChar(240)
  cancelReason               String?                    @db.VarChar(80)
  createdAt                  DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime                   @updatedAt @db.Timestamptz(3)
  outboxEvent                OutboxEvent                @relation(fields: [outboxEventId], references: [id], onDelete: Restrict)
  recipientUser              User?                      @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Restrict)

  @@unique([outboxEventId, channel, recipientAddressHash, templateKey, templateVersion])
  @@index([status, availableAt])
  @@index([outboxEventId])
  @@index([recipientUserId, createdAt])
  @@map("notification_deliveries")
}

model Client {
  id              String           @id @default(uuid()) @db.Uuid
  displayName     String           @db.VarChar(180)
  status          ClientStatus     @default(ACTIVE)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  users           User[]
  contacts        ClientContact[]
  quoteRequests   QuoteRequest[]
  quotes          Quote[]
  conversations   Conversation[]
  fileAttachments FileAttachment[]
  projects        Project[]

  @@index([status, createdAt])
  @@map("clients")
}

model User {
  id                              String                    @id @default(uuid()) @db.Uuid
  email                           String                    @db.VarChar(320)
  emailNormalized                 String                    @unique @db.VarChar(320)
  displayName                     String                    @db.VarChar(180)
  type                            UserType
  status                          UserStatus                @default(INVITED)
  passwordHash                    String?                   @db.VarChar(255)
  mfaRequired                     Boolean                   @default(false)
  mfaSecretCiphertext             String?                   @db.VarChar(512)
  mfaEnrolledAt                   DateTime?                 @db.Timestamptz(3)
  mfaLastAcceptedCounter          Int?
  clientId                        String?                   @db.Uuid
  client                          Client?                   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  contactProfile                  ClientContact?
  roles                           UserRole[]
  sessions                        Session[]
  authTokens                      AuthToken[]
  authEvents                      AuthEvent[]
  currentQuoteRequests            QuoteRequest[]            @relation("QuoteRequestCurrentAssignee")
  requestAssignmentsAssigned      RequestAssignment[]       @relation("RequestAssignmentAssignee")
  requestAssignmentsCreated       RequestAssignment[]       @relation("RequestAssignmentActor")
  requestStatusChanges            RequestStatusHistory[]    @relation("RequestStatusHistoryActor")
  quoteVersionsCreated            QuoteVersion[]            @relation("QuoteVersionCreator")
  quoteAcceptances                QuoteAcceptance[]         @relation("QuoteAcceptanceActor")
  quoteStatusChanges              QuoteStatusHistory[]      @relation("QuoteStatusHistoryActor")
  closedConversations             Conversation[]            @relation("ConversationCloser")
  conversationMessages            ConversationMessage[]     @relation("ConversationMessageSender")
  uploadedFileAttachments         FileAttachment[]          @relation("FileAttachmentUploader")
  notificationDeliveries          NotificationDelivery[]    @relation("NotificationRecipient")
  quoteApprovalsRequested         QuoteApproval[]           @relation("QuoteApprovalRequester")
  quoteApprovalsDecided           QuoteApproval[]           @relation("QuoteApprovalDecider")
  specialConceptPromotions        SpecialConceptPromotion[]
  commercialPolicyVersionsCreated CommercialPolicyVersion[] @relation("CommercialPolicyCreator")
  commercialTermsVersionsCreated  CommercialTermsVersion[]  @relation("CommercialTermsCreator")
  quotePublications               QuotePublication[]        @relation("QuotePublicationActor")
  conversationReadStates          ConversationReadState[]
  projectsOwned                   Project[]                 @relation("ProjectOwner")
  projectsCreated                 Project[]                 @relation("ProjectCreator")
  projectChecklistItemsCompleted  ProjectChecklistItem[]     @relation("ProjectChecklistCompletedBy")
  createdAt                       DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt                       DateTime                  @updatedAt @db.Timestamptz(3)

  @@index([clientId, status])
  @@index([type, status])
  @@map("users")
}

model ClientContact {
  id              String         @id @default(uuid()) @db.Uuid
  clientId        String         @db.Uuid
  userId          String?        @unique @db.Uuid
  displayName     String         @db.VarChar(180)
  email           String         @db.VarChar(320)
  emailNormalized String         @db.VarChar(320)
  phone           String?        @db.VarChar(40)
  roleTitle       String?        @db.VarChar(120)
  isPrimary       Boolean        @default(false)
  status          ContactStatus  @default(ACTIVE)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)
  client          Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  quoteRequests   QuoteRequest[]
  projects        Project[]

  @@unique([clientId, emailNormalized])
  @@index([clientId, status, createdAt])
  @@map("client_contacts")
}

model QuoteRequest {
  id                 String                 @id @default(uuid()) @db.Uuid
  folio              String                 @unique @db.VarChar(24)
  idempotencyKeyHash String?                @unique @db.VarChar(64)
  clientId           String                 @db.Uuid
  contactId          String                 @db.Uuid
  currentAssigneeId  String?                @db.Uuid
  origin             QuoteRequestOrigin
  status             QuoteRequestStatus     @default(RECIBIDA)
  createdAt          DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime               @updatedAt @db.Timestamptz(3)
  client             Client                 @relation(fields: [clientId], references: [id], onDelete: Restrict)
  contact            ClientContact          @relation(fields: [contactId], references: [id], onDelete: Restrict)
  currentAssignee    User?                  @relation("QuoteRequestCurrentAssignee", fields: [currentAssigneeId], references: [id], onDelete: SetNull)
  detail             QuoteRequestDetail?
  quotes             Quote[]
  assignments        RequestAssignment[]
  statusHistory      RequestStatusHistory[]
  conversation       Conversation?
  fileAttachments    FileAttachment[]
  project            Project?

  @@unique([id, clientId])
  @@index([status, createdAt])
  @@index([currentAssigneeId, status, createdAt])
  @@index([clientId, createdAt])
  @@map("quote_requests")
}

model Conversation {
  id             String                  @id @default(uuid()) @db.Uuid
  quoteRequestId String                  @unique @db.Uuid
  clientId       String                  @db.Uuid
  status         ConversationStatus      @default(OPEN)
  createdAt      DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                @updatedAt @db.Timestamptz(3)
  closedAt       DateTime?               @db.Timestamptz(3)
  closedById     String?                 @db.Uuid
  quoteRequest   QuoteRequest            @relation(fields: [quoteRequestId, clientId], references: [id, clientId], onDelete: Cascade)
  client         Client                  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  closedBy       User?                   @relation("ConversationCloser", fields: [closedById], references: [id], onDelete: SetNull)
  messages       ConversationMessage[]
  readStates     ConversationReadState[]

  @@unique([quoteRequestId, clientId])
  @@index([clientId, status, updatedAt])
  @@index([status, updatedAt])
  @@map("conversations")
}

model ConversationMessage {
  id                 String                  @id @default(uuid()) @db.Uuid
  conversationId     String                  @db.Uuid
  senderUserId       String?                 @db.Uuid
  visibility         MessageVisibility
  body               String                  @db.Text
  idempotencyKeyHash String?                 @db.VarChar(64)
  createdAt          DateTime                @default(now()) @db.Timestamptz(3)
  conversation       Conversation            @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender             User?                   @relation("ConversationMessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)
  readAsLastBy       ConversationReadState[]

  @@unique([conversationId, senderUserId, idempotencyKeyHash])
  @@index([conversationId, createdAt, id])
  @@index([conversationId, visibility, createdAt, id])
  @@map("conversation_messages")
}

/// W1-01: per-actor read position, deliberately deferred out of Fase 6 until
/// a product contract, permission story and monotonic-progress guarantee
/// existed (see PROJECT_STATUS.md invariant #36). No new permission: reading
/// a conversation already requires `messaging.read`/`messaging.internal_notes.read`,
/// and marking it read is a byproduct of that, not a separate capability.
/// `lastReadAt` only ever advances (enforced in the upsert, not just here) --
/// a stale/out-of-order write must never regress an actor's read position.
model ConversationReadState {
  id                String               @id @default(uuid()) @db.Uuid
  conversationId    String               @db.Uuid
  userId            String               @db.Uuid
  lastReadMessageId String?              @db.Uuid
  lastReadAt        DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @db.Timestamptz(3)
  conversation      Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadMessage   ConversationMessage? @relation(fields: [lastReadMessageId], references: [id], onDelete: SetNull)

  @@unique([conversationId, userId])
  @@index([userId, lastReadAt])
  @@map("conversation_read_states")
}

model StorageObject {
  id                String             @id @default(uuid()) @db.Uuid
  provider          StorageProvider    @default(MINIO)
  storageKey        String             @unique @db.VarChar(255)
  contentType       String             @db.VarChar(120)
  byteSize          BigInt
  sha256            String?            @db.Char(64)
  etag              String?            @db.VarChar(128)
  scanStatus        FileScanStatus     @default(PENDING)
  scannerName       String?            @db.VarChar(120)
  scanReason        String?            @db.VarChar(300)
  scannedAt         DateTime?          @db.Timestamptz(3)
  verifiedAt        DateTime?          @db.Timestamptz(3)
  deletedAt         DateTime?          @db.Timestamptz(3)
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  attachment        FileAttachment?
  generatedDocument GeneratedDocument?

  @@index([scanStatus, createdAt])
  @@index([deletedAt, createdAt])
  @@map("storage_objects")
}

model FileAttachment {
  id                   String               @id @default(uuid()) @db.Uuid
  quoteRequestId       String               @db.Uuid
  clientId             String               @db.Uuid
  storageObjectId      String               @unique @db.Uuid
  originalFileName     String               @db.VarChar(180)
  category             FileCategory
  visibility           FileVisibility
  status               FileAttachmentStatus @default(PENDING_SCAN)
  uploadedById         String               @db.Uuid
  reservationKeyHash   String?              @db.Char(64)
  reservationExpiresAt DateTime?            @db.Timestamptz(3)
  createdAt            DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @db.Timestamptz(3)
  deletedAt            DateTime?            @db.Timestamptz(3)
  quoteRequest         QuoteRequest         @relation(fields: [quoteRequestId, clientId], references: [id, clientId], onDelete: Cascade)
  client               Client               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  storageObject        StorageObject        @relation(fields: [storageObjectId], references: [id], onDelete: Restrict)
  uploadedBy           User                 @relation("FileAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@unique([uploadedById, reservationKeyHash])
  @@index([quoteRequestId, status, createdAt])
  @@index([clientId, visibility, status, createdAt])
  @@index([uploadedById, createdAt])
  @@index([status, reservationExpiresAt])
  @@map("file_attachments")
}

model GeneratedDocument {
  id              String                  @id @default(uuid()) @db.Uuid
  quoteId         String                  @db.Uuid
  quoteVersionId  String                  @db.Uuid
  storageObjectId String?                 @unique @db.Uuid
  documentType    GeneratedDocumentType   @default(QUOTE_PDF)
  status          GeneratedDocumentStatus @default(PENDING)
  templateVersion String                  @db.VarChar(64)
  contentType     String                  @default("application/pdf") @db.VarChar(120)
  byteSize        BigInt?
  sha256          String?                 @db.Char(64)
  failureCode     String?                 @db.VarChar(120)
  generatedAt     DateTime?               @db.Timestamptz(3)
  readyAt         DateTime?               @db.Timestamptz(3)
  createdAt       DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime?               @db.Timestamptz(3)
  quote           Quote                   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteVersion    QuoteVersion            @relation(fields: [quoteVersionId, quoteId], references: [id, quoteId], onDelete: Cascade)
  storageObject   StorageObject?          @relation(fields: [storageObjectId], references: [id], onDelete: Restrict)
  acceptance      QuoteAcceptance?
  publication     QuotePublication?

  @@unique([quoteVersionId, documentType])
  @@index([quoteId, status, documentType])
  @@index([status, updatedAt])
  @@map("generated_documents")
}

model QuoteAcceptance {
  id                   String            @id @default(uuid()) @db.Uuid
  quoteId              String            @db.Uuid
  quoteVersionId       String            @db.Uuid
  generatedDocumentId  String            @unique @db.Uuid
  acceptedById         String            @db.Uuid
  documentSha256       String            @db.Char(64)
  signerName           String            @db.VarChar(180)
  termsVersion         String            @db.VarChar(64)
  idempotencyKeyHash   String            @db.Char(64)
  ipFingerprint        String?           @db.Char(64)
  userAgentFingerprint String?           @db.Char(64)
  acceptedAt           DateTime          @default(now()) @db.Timestamptz(3)
  quote                Quote             @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteVersion         QuoteVersion      @relation(fields: [quoteVersionId, quoteId], references: [id, quoteId], onDelete: Cascade)
  generatedDocument    GeneratedDocument @relation(fields: [generatedDocumentId], references: [id], onDelete: Restrict)
  acceptedBy           User              @relation("QuoteAcceptanceActor", fields: [acceptedById], references: [id], onDelete: Restrict)
  project              Project?

  @@unique([quoteVersionId, quoteId])
  @@unique([acceptedById, idempotencyKeyHash])
  @@index([quoteId, acceptedAt])
  @@index([acceptedById, acceptedAt])
  @@map("quote_acceptances")
}

/// J1-01: the minimum real handoff model -- "closes the commercial cycle without pretending a full
/// construction module exists" (§22 of the archived V2 plan, BIZ-13). Deliberately does NOT model a
/// build schedule, inventory, payments or suppliers; `quoteAcceptanceId` being unique is what
/// enforces "one acceptance -> at most one project" at the database level, not application logic.
/// Scope comes from the already-immutable `QuoteVersion` snapshot the acceptance points to -- no
/// separate "ProjectScopeSnapshot" copy table, since re-copying an already-frozen snapshot into a
/// second table would only risk drifting from it for zero correctness benefit.
model Project {
  id                String               @id @default(uuid()) @db.Uuid
  folio             String               @unique @db.VarChar(24)
  quoteAcceptanceId String               @unique @db.Uuid
  quoteRequestId    String               @unique @db.Uuid
  clientId          String               @db.Uuid
  contactId         String               @db.Uuid
  ownerId           String?              @db.Uuid
  status            ProjectHandoffStatus @default(EN_TRANSICION)
  createdById       String               @db.Uuid
  completedAt       DateTime?            @db.Timestamptz(3)
  createdAt         DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @db.Timestamptz(3)
  quoteAcceptance   QuoteAcceptance      @relation(fields: [quoteAcceptanceId], references: [id], onDelete: Restrict)
  quoteRequest      QuoteRequest         @relation(fields: [quoteRequestId], references: [id], onDelete: Restrict)
  client            Client               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  contact           ClientContact        @relation(fields: [contactId], references: [id], onDelete: Restrict)
  owner             User?                @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy         User                 @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  checklistItems    ProjectChecklistItem[]

  @@index([clientId, createdAt])
  @@index([ownerId, status])
  @@map("projects")
}

/// J1-01: deliberately free-text/staff-authored, not a fixed hardcoded template -- specific handoff
/// task content is an operational business decision, not one for this codebase to invent on its own.
model ProjectChecklistItem {
  id            String    @id @default(uuid()) @db.Uuid
  projectId     String    @db.Uuid
  label         String    @db.VarChar(240)
  position      Int       @default(0)
  completedAt   DateTime? @db.Timestamptz(3)
  completedById String?   @db.Uuid
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  completedBy   User?     @relation("ProjectChecklistCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  @@unique([projectId, position])
  @@map("project_checklist_items")
}

model QuoteRequestDetail {
  id             String                    @id @default(uuid()) @db.Uuid
  quoteRequestId String                    @unique @db.Uuid
  projectType    String                    @db.VarChar(120)
  location       String                    @db.VarChar(180)
  projectStage   QuoteRequestProjectStage?
  dimensions     String?                   @db.VarChar(500)
  timeline       QuoteRequestTimeline?
  budgetRange    QuoteRequestBudgetRange?
  budgetCents    BigInt?
  currencyCode   String                    @default("MXN") @db.Char(3)
  description    String                    @db.Text
  consentAt      DateTime                  @db.Timestamptz(3)
  createdAt      DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                  @updatedAt @db.Timestamptz(3)
  quoteRequest   QuoteRequest              @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)

  @@map("quote_request_details")
}

model CatalogCategory {
  id          String            @id @default(uuid()) @db.Uuid
  code        String            @unique @db.VarChar(64)
  name        String            @db.VarChar(180)
  description String?           @db.VarChar(500)
  status      CatalogStatus     @default(ACTIVE)
  sortOrder   Int               @default(0)
  parentId    String?           @db.Uuid
  parent      CatalogCategory?  @relation("CatalogCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    CatalogCategory[] @relation("CatalogCategoryTree")
  items       CatalogItem[]
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)

  @@index([parentId, status, sortOrder])
  @@index([status, sortOrder, name])
  @@map("catalog_categories")
}

model CatalogItem {
  id          String                    @id @default(uuid()) @db.Uuid
  code        String                    @unique @db.VarChar(64)
  name        String                    @db.VarChar(180)
  description String?                   @db.Text
  unit        String                    @db.VarChar(40)
  status      CatalogStatus             @default(ACTIVE)
  categoryId  String?                   @db.Uuid
  category    CatalogCategory?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  prices      PriceListItem[]
  quoteLines  QuoteLineSnapshot[]
  promotions  SpecialConceptPromotion[]
  createdAt   DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime                  @updatedAt @db.Timestamptz(3)

  @@index([status, name])
  @@index([categoryId, status, name])
  @@map("catalog_items")
}

model PriceList {
  id                   String          @id @default(uuid()) @db.Uuid
  code                 String          @unique @db.VarChar(64)
  name                 String          @db.VarChar(180)
  currencyCode         String          @db.Char(3)
  status               PriceListStatus @default(ACTIVE)
  validFrom            DateTime        @default(now()) @db.Timestamptz(3)
  validUntil           DateTime?       @db.Timestamptz(3)
  items                PriceListItem[]
  sourcedQuoteVersions QuoteVersion[]
  createdAt            DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime        @updatedAt @db.Timestamptz(3)

  @@index([currencyCode, status, validFrom])
  @@map("price_lists")
}

model PriceListItem {
  id             String      @id @default(uuid()) @db.Uuid
  priceListId    String      @db.Uuid
  catalogItemId  String      @db.Uuid
  unitPriceMinor BigInt
  validFrom      DateTime    @default(now()) @db.Timestamptz(3)
  validUntil     DateTime?   @db.Timestamptz(3)
  priceList      PriceList   @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  catalogItem    CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)

  @@unique([priceListId, catalogItemId, validFrom])
  @@index([priceListId, catalogItemId, validFrom, validUntil])
  @@map("price_list_items")
}

model Quote {
  id                 String              @id @default(uuid()) @db.Uuid
  quoteRequestId     String              @db.Uuid
  clientId           String              @db.Uuid
  currentVersionId   String?             @unique @db.Uuid
  workingVersionId   String?             @unique @db.Uuid
  publishedVersionId String?             @unique @db.Uuid
  quoteRequest       QuoteRequest        @relation(fields: [quoteRequestId, clientId], references: [id, clientId], onDelete: Restrict)
  client             Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  currentVersion     QuoteVersion?       @relation("QuoteCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  workingVersion     QuoteVersion?       @relation("QuoteWorkingVersion", fields: [workingVersionId], references: [id], onDelete: SetNull)
  publishedVersion   QuoteVersion?       @relation("QuotePublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  versions           QuoteVersion[]      @relation("QuoteVersions")
  generatedDocuments GeneratedDocument[]
  quoteAcceptances   QuoteAcceptance[]
  approvals          QuoteApproval[]
  publications       QuotePublication[]
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)

  @@unique([quoteRequestId])
  @@index([clientId, createdAt])
  @@map("quotes")
}

model QuoteVersion {
  id                 String                   @id @default(uuid()) @db.Uuid
  quoteId            String                   @db.Uuid
  versionNumber      Int                      @default(1)
  status             QuoteVersionStatus       @default(BORRADOR)
  currencyCode       String                   @db.Char(3)
  validUntil         DateTime?                @db.Timestamptz(3)
  subtotalMinor      BigInt                   @default(0)
  discountTotalMinor BigInt                   @default(0)
  taxableTotalMinor  BigInt                   @default(0)
  taxTotalMinor      BigInt                   @default(0)
  totalMinor         BigInt                   @default(0)
  createdById        String                   @db.Uuid
  /// D1-01: real optimistic-concurrency counter, replacing the `updatedAt`
  /// stand-in that D2-04/Q1-05 use today. Incremented by every command that
  /// mutates content.
  revision           Int                      @default(1)
  /// D1-01: sha256 of the frozen content (sections + lines + totals + terms),
  /// same digest algorithm QuoteApproval.digest already uses.
  contentDigest      String?                  @db.Char(64)
  publishedAt        DateTime?                @db.Timestamptz(3)
  supersededAt       DateTime?                @db.Timestamptz(3)
  /// D1-02: structured commercial content, published to client/PDF verbatim.
  scopeText          String?                  @db.Text
  exclusionsText     String?                  @db.Text
  paymentTermsText   String?                  @db.Text
  warrantyText       String?                  @db.Text
  publicNotesText    String?                  @db.Text
  /// D1-03: nullable while BORRADOR; resolved before EN_REVISION.
  taxProfileId       String?                  @db.Uuid
  commercialPolicyId String?                  @db.Uuid
  termsVersionId     String?                  @db.Uuid
  sourcePriceListId  String?                  @db.Uuid
  quote              Quote                    @relation("QuoteVersions", fields: [quoteId], references: [id], onDelete: Cascade)
  currentForQuote    Quote?                   @relation("QuoteCurrentVersion")
  workingForQuote    Quote?                   @relation("QuoteWorkingVersion")
  publishedForQuote  Quote?                   @relation("QuotePublishedVersion")
  createdBy          User                     @relation("QuoteVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  taxProfile         TaxProfileVersion?       @relation(fields: [taxProfileId], references: [id], onDelete: Restrict)
  commercialPolicy   CommercialPolicyVersion? @relation(fields: [commercialPolicyId], references: [id], onDelete: Restrict)
  termsVersion       CommercialTermsVersion?  @relation(fields: [termsVersionId], references: [id], onDelete: Restrict)
  sourcePriceList    PriceList?               @relation(fields: [sourcePriceListId], references: [id], onDelete: SetNull)
  lines              QuoteLineSnapshot[]
  sections           QuoteSectionSnapshot[]
  statusHistory      QuoteStatusHistory[]
  generatedDocuments GeneratedDocument[]
  acceptance         QuoteAcceptance?
  approvals          QuoteApproval[]
  publication        QuotePublication?
  createdAt          DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                 @updatedAt @db.Timestamptz(3)

  @@unique([quoteId, versionNumber])
  @@unique([id, quoteId])
  @@index([quoteId, status, createdAt])
  @@index([createdById, createdAt])
  @@map("quote_versions")
}

model QuoteLineSnapshot {
  id                  String                @id @default(uuid()) @db.Uuid
  quoteVersionId      String                @db.Uuid
  /// D1-02: explicit order, replacing reliance on `id` insertion order (which
  /// does not preserve submission order — see Q1-05 client-side merge gotcha).
  position            Int                   @default(0)
  sectionId           String?               @db.Uuid
  catalogItemId       String?               @db.Uuid
  catalogItemCode     String?               @db.VarChar(64)
  name                String                @db.VarChar(180)
  description         String?               @db.Text
  unit                String                @db.VarChar(40)
  specialReason       String?               @db.VarChar(300)
  quantityMilliunits  BigInt
  currencyCode        String                @db.Char(3)
  /// D1-02: catalog price before any override, distinct from `unitPriceMinor`
  /// (the final, possibly overridden, price already snapshotted below).
  baseUnitPriceMinor  BigInt?
  overrideReason      String?               @db.VarChar(300)
  unitPriceMinor      BigInt
  discountBasisPoints Int                   @default(0)
  discountMinor       BigInt                @default(0)
  taxableMinor        BigInt                @default(0)
  taxBasisPoints      Int                   @default(0)
  taxMinor            BigInt                @default(0)
  subtotalMinor       BigInt                @default(0)
  totalMinor          BigInt                @default(0)
  quoteVersion        QuoteVersion          @relation(fields: [quoteVersionId], references: [id], onDelete: Cascade)
  section             QuoteSectionSnapshot? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  catalogItem         CatalogItem?          @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)

  @@unique([quoteVersionId, position])
  @@index([quoteVersionId])
  @@index([catalogItemId, quoteVersionId])
  @@index([sectionId])
  @@map("quote_line_snapshots")
}

/// D1-02: optional grouping for quote lines (title + description); a line
/// without a section remains valid so Q1-03 can build on this without
/// forcing every historical/simple quote to have sections.
model QuoteSectionSnapshot {
  id             String              @id @default(uuid()) @db.Uuid
  quoteVersionId String              @db.Uuid
  position       Int
  title          String              @db.VarChar(180)
  description    String?             @db.Text
  quoteVersion   QuoteVersion        @relation(fields: [quoteVersionId], references: [id], onDelete: Cascade)
  lines          QuoteLineSnapshot[]
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)

  @@unique([quoteVersionId, position])
  @@map("quote_section_snapshots")
}

/// K1-05 parte 2: sólo-inserción, nunca se actualiza. Registra qué texto de
/// concepto especial (nombre+unidad normalizados) ya fue promovido a un
/// CatalogItem real, para deduplicar promociones repetidas del mismo texto.
model SpecialConceptPromotion {
  id             String      @id @default(uuid()) @db.Uuid
  normalizedName String      @db.VarChar(180)
  /// Normalized (NFC + trim + collapsed whitespace + lowercase) unit, same
  /// normalization as normalizedName — never a raw display unit.
  unit           String      @db.VarChar(40)
  catalogItemId  String      @db.Uuid
  promotedById   String      @db.Uuid
  promotedAt     DateTime    @default(now()) @db.Timestamptz(3)
  catalogItem    CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)
  promotedBy     User        @relation(fields: [promotedById], references: [id], onDelete: Restrict)

  @@unique([normalizedName, unit])
  @@index([catalogItemId])
  @@map("special_concept_promotions")
}

model QuoteStatusHistory {
  id             String              @id @default(uuid()) @db.Uuid
  quoteVersionId String              @db.Uuid
  fromStatus     QuoteVersionStatus?
  toStatus       QuoteVersionStatus
  changedById    String?             @db.Uuid
  reason         String?             @db.VarChar(500)
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  quoteVersion   QuoteVersion        @relation(fields: [quoteVersionId], references: [id], onDelete: Cascade)
  changedBy      User?               @relation("QuoteStatusHistoryActor", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([quoteVersionId, createdAt])
  @@index([changedById, createdAt])
  @@map("quote_status_history")
}

model QuoteApproval {
  id             String              @id @default(uuid()) @db.Uuid
  quoteId        String              @db.Uuid
  quoteVersionId String              @db.Uuid
  type           QuoteApprovalType
  status         QuoteApprovalStatus @default(REQUESTED)
  policyVersion  String              @db.VarChar(64)
  digest         String              @db.Char(64)
  thresholdBps   Int?
  reason         String?             @db.VarChar(500)
  requestedById  String              @db.Uuid
  decidedById    String?             @db.Uuid
  requestedAt    DateTime            @default(now()) @db.Timestamptz(3)
  decidedAt      DateTime?           @db.Timestamptz(3)
  expiresAt      DateTime?           @db.Timestamptz(3)
  quote          Quote               @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteVersion   QuoteVersion        @relation(fields: [quoteVersionId, quoteId], references: [id, quoteId], onDelete: Cascade)
  requestedBy    User                @relation("QuoteApprovalRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy      User?               @relation("QuoteApprovalDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([quoteVersionId, type, digest])
  @@index([quoteVersionId, type, status])
  @@index([quoteId, status, requestedAt])
  @@index([requestedById, requestedAt])
  @@index([decidedById, decidedAt])
  @@map("quote_approvals")
}

/// D1-03: versioned commercial policy (currency/precision/timezone/discount
/// threshold). Immutable once referenced by a QuoteVersion; a change creates
/// a new version and marks the previous one `active=false`.
model CommercialPolicyVersion {
  id                           String         @id @default(uuid()) @db.Uuid
  versionTag                   String         @unique @db.VarChar(64)
  currencyCode                 String         @db.Char(3)
  precision                    Int            @default(2)
  timezone                     String         @db.VarChar(64)
  /// BIZ-06/07: discounts at or below this threshold (basis points of the
  /// version subtotal) do not require manager approval.
  discountApprovalThresholdBps Int            @default(1000)
  active                       Boolean        @default(true)
  /// Nullable: system-seeded policy versions (the initial default) have no
  /// human actor, same convention already used by QuoteStatusHistory.changedById.
  createdById                  String?        @db.Uuid
  createdBy                    User?          @relation("CommercialPolicyCreator", fields: [createdById], references: [id], onDelete: SetNull)
  quoteVersions                QuoteVersion[]
  createdAt                    DateTime       @default(now()) @db.Timestamptz(3)

  @@index([active, createdAt])
  @@map("commercial_policy_versions")
}

/// D1-03/BIZ-03: tax RATE profile only — never a fiscal identity. No RFC or
/// régimen fiscal field belongs here; see ADR 2026-09-19.
model TaxProfileVersion {
  id                     String          @id @default(uuid()) @db.Uuid
  code                   String          @unique @db.VarChar(32)
  name                   String          @db.VarChar(120)
  ratePercentBasisPoints Int
  roundingRule           TaxRoundingRule @default(HALF_UP)
  currencyCode           String          @db.Char(3)
  active                 Boolean         @default(true)
  quoteVersions          QuoteVersion[]
  createdAt              DateTime        @default(now()) @db.Timestamptz(3)

  @@index([active, currencyCode])
  @@map("tax_profile_versions")
}

/// D1-03/BIZ-10: immutable once referenced by a QuoteVersion; a text change
/// creates a new version, it never edits an already-used one.
model CommercialTermsVersion {
  id              String             @id @default(uuid()) @db.Uuid
  versionTag      String             @unique @db.VarChar(64)
  title           String             @db.VarChar(180)
  bodyMarkdown    String             @db.Text
  privacyMarkdown String             @db.Text
  active          Boolean            @default(true)
  /// Nullable: system-seeded terms versions (the initial default) have no
  /// human actor, same convention already used by QuoteStatusHistory.changedById.
  createdById     String?            @db.Uuid
  createdBy       User?              @relation("CommercialTermsCreator", fields: [createdById], references: [id], onDelete: SetNull)
  quoteVersions   QuoteVersion[]
  publications    QuotePublication[]
  publishedAt     DateTime           @default(now()) @db.Timestamptz(3)

  @@index([active, publishedAt])
  @@map("commercial_terms_versions")
}

/// D1-04: one row per real publish event, distinct from QuoteStatusHistory
/// (which records every transition, not only publications). Lets D2/P1 ask
/// "when and with what digest was this actually published" directly.
model QuotePublication {
  id                 String                 @id @default(uuid()) @db.Uuid
  quoteId            String                 @db.Uuid
  quoteVersionId     String                 @db.Uuid
  documentId         String                 @unique @db.Uuid
  termsVersionId     String                 @db.Uuid
  preflightDigest    String                 @db.Char(64)
  /// Hash only — never the recipient email in clear, same policy already
  /// applied to other sensitive fields elsewhere in the audit trail.
  recipientEmailHash String                 @db.Char(64)
  status             QuotePublicationStatus @default(PUBLISHED)
  publishedAt        DateTime               @default(now()) @db.Timestamptz(3)
  publishedById      String                 @db.Uuid
  quote              Quote                  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteVersion       QuoteVersion           @relation(fields: [quoteVersionId, quoteId], references: [id, quoteId], onDelete: Cascade)
  document           GeneratedDocument      @relation(fields: [documentId], references: [id], onDelete: Restrict)
  termsVersion       CommercialTermsVersion @relation(fields: [termsVersionId], references: [id], onDelete: Restrict)
  publishedBy        User                   @relation("QuotePublicationActor", fields: [publishedById], references: [id], onDelete: Restrict)

  @@unique([quoteVersionId, quoteId])
  @@index([quoteId, publishedAt])
  @@map("quote_publications")
}

model RequestAssignment {
  id             String       @id @default(uuid()) @db.Uuid
  quoteRequestId String       @db.Uuid
  assignedToId   String       @db.Uuid
  assignedById   String       @db.Uuid
  reason         String?      @db.VarChar(500)
  assignedAt     DateTime     @default(now()) @db.Timestamptz(3)
  unassignedAt   DateTime?    @db.Timestamptz(3)
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  assignedTo     User         @relation("RequestAssignmentAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  assignedBy     User         @relation("RequestAssignmentActor", fields: [assignedById], references: [id], onDelete: Restrict)

  @@index([quoteRequestId, assignedAt])
  @@index([assignedToId, unassignedAt, assignedAt])
  @@map("request_assignments")
}

model RequestStatusHistory {
  id             String              @id @default(uuid()) @db.Uuid
  quoteRequestId String              @db.Uuid
  fromStatus     QuoteRequestStatus?
  toStatus       QuoteRequestStatus
  changedById    String?             @db.Uuid
  reason         String?             @db.VarChar(500)
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  quoteRequest   QuoteRequest        @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  changedBy      User?               @relation("RequestStatusHistoryActor", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([quoteRequestId, createdAt])
  @@index([changedById, createdAt])
  @@map("request_status_history")
}

model FolioSequence {
  key       String   @id @db.VarChar(80)
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("folio_sequences")
}

model Role {
  id            String           @id @default(uuid()) @db.Uuid
  key           String           @unique @db.VarChar(80)
  name          String           @db.VarChar(120)
  description   String           @db.VarChar(300)
  systemManaged Boolean          @default(true)
  userRoles     UserRole[]
  permissions   RolePermission[]
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(3)

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique @db.VarChar(120)
  description String           @db.VarChar(300)
  roles       RolePermission[]
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)

  @@map("permissions")
}

model UserRole {
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([userId, roleId])
  @@index([roleId, userId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)

  @@id([roleId, permissionId])
  @@index([permissionId, roleId])
  @@map("role_permissions")
}

model Session {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  tokenHash   String    @unique @db.VarChar(64)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt   DateTime  @db.Timestamptz(3)
  lastSeenAt  DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt   DateTime? @db.Timestamptz(3)
  mfaVerified Boolean   @default(false)
  ipAddress   String?   @db.VarChar(64)
  userAgent   String?   @db.VarChar(512)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

model AuthToken {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @db.Uuid
  type        AuthTokenType
  tokenHash   String        @unique @db.VarChar(64)
  expiresAt   DateTime      @db.Timestamptz(3)
  consumedAt  DateTime?     @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  requestedIp String?       @db.VarChar(64)
  userAgent   String?       @db.VarChar(512)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, expiresAt])
  @@index([type, consumedAt, expiresAt])
  @@map("auth_tokens")
}

model AuthEvent {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String?          @db.Uuid
  eventType      AuthEventType
  outcome        AuthEventOutcome
  identifierHash String?          @db.VarChar(64)
  ipAddress      String?          @db.VarChar(64)
  userAgent      String?          @db.VarChar(512)
  metadata       Json?
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  user           User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
  @@index([identifierHash, createdAt])
  @@map("auth_events")
}

model AuthRateLimit {
  id            String    @id @default(uuid()) @db.Uuid
  scope         String    @db.VarChar(80)
  keyHash       String    @db.VarChar(64)
  windowStarted DateTime  @db.Timestamptz(3)
  attempts      Int       @default(0)
  blockedUntil  DateTime? @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([scope, keyHash])
  @@index([blockedUntil])
  @@map("auth_rate_limits")
}
